# What one install of the portal needs in its environment - set these on the PHP
# app in Coolify (runtime, not build time). Every install belongs to one company,
# so none of them has a default that points at another company.
#
# The portal's name, footer and support contacts are not here: the Director sets
# those on the Settings page.

# Required
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# Required for email. This install's own address, with no trailing slash: every
# link in an email starts with it, and with none set no email is sent.
APP_URL=https://portal.example.com
SMTP_USER=portal@example.com
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587

# Optional. A copy of every form response, only if these are set.
RESPONSE_COPY_EMAIL=
SURVEY_WEBHOOK_URL=

# Optional. The MCP server's address, advertised in llms.txt.
MCP_PUBLIC_URL=
