{
  "name": "wzone-mcp-server",
  "version": "1.1.0",
  "description": "Standalone read-only MCP server for W|ZONE's public inquiry data. Calls the existing PHP application over HTTPS - holds no database credentials.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
