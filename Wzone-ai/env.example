# Base URL of the W|ZONE PHP application this MCP server talks to.
# No trailing slash. Change this one value when the domain moves -
# nothing else in this project hardcodes the domain.
WZONE_BASE_URL=https://survey.websitezone.co.uk

# Port this MCP server itself listens on (not the PHP app's port).
MCP_PORT=8787

# Defense-in-depth rate limit for this MCP server's own HTTP endpoint.
# The primary limit lives in the PHP API (api/inquiry-lookup.php) since
# that endpoint is reachable with or without this server existing; this
# is a second, independent layer in front of it.
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_REQUESTS=60

# How long to wait for the PHP API to respond before giving up.
WZONE_REQUEST_TIMEOUT_MS=8000

# error | warn | info | debug
LOG_LEVEL=info
