# Base URL of the W|ZONE PHP application this MCP server talks to.
# No trailing slash. Change this one value when the domain moves -
# nothing else in this project hardcodes the domain.
WZONE_BASE_URL=https://survey.websitezone.co.uk

# Port this MCP server itself listens on (not the PHP app's port).
MCP_PORT=8787

# Defense-in-depth rate limit for this MCP server's own HTTP endpoint.
# The primary limit lives in the PHP API (api/inquiry-lookup.php) since
# that endpoint is reachable with or without this server existing; this
# is a second, independent layer in front of it.
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_REQUESTS=60

# How long to wait for the PHP API to respond before giving up.
WZONE_REQUEST_TIMEOUT_MS=8000

# error | warn | info | debug
LOG_LEVEL=info

# How long a successful lookup is reused before PHP is asked again.
# 0 turns caching off. Failures (not found, rate-limited) are never cached.
WZONE_CACHE_TTL_MS=60000

# How many reverse-proxy hops sit in front of this server: 1 for
# Coolify's Traefik, 2 if a CDN is added in front of that, 0 if this is
# ever exposed with no proxy at all. Too high a value lets callers forge
# X-Forwarded-For and dodge the per-caller rate limit above.
TRUST_PROXY_HOPS=1

# Shared secret sent to the PHP side as X-MCP-Key. Set the SAME value as
# MCP_UPSTREAM_KEY on the PHP application, and inquiry-lookup.php gives
# this server its own, larger rate-limit bucket (all AI callers together)
# instead of the per-visitor one. Generate with: openssl rand -hex 32
# Leave empty and this server is treated like any other visitor.
MCP_UPSTREAM_KEY=

# Signs the confirmation tokens that join prepare_inquiry_submission to
# submit_inquiry_response (at least 32 characters). Set this AND
# MCP_UPSTREAM_KEY to offer the submit tools; leave it empty and the
# server stays read-only. Generate with: openssl rand -hex 32
# Rotating it only invalidates confirmations issued in the last 15 min.
MCP_SIGNING_KEY=

# Per-caller cap on submissions: at most MCP_SUBMIT_MAX in each window.
MCP_SUBMIT_MAX=5
MCP_SUBMIT_WINDOW_MS=600000

# ── Which server this deployment is ─────────────────────────────────────
# public  (default) anonymous: get_inquiry, the intake prompt, confirmed
#         submission. mcp.websitezone.co.uk.
# private OAuth required: the portal as the signed-in staff member or
#         client (whoami today; the other tools build on it). Deploy it as
#         a SECOND Coolify app from the same folder, e.g.
#         portal-mcp.websitezone.co.uk.
MCP_MODE=public

# private only: this server's own public https origin, no trailing path.
# It is the OAuth issuer and, with /mcp, the only audience tokens are
# issued for. Must match the domain Coolify serves this app on.
MCP_PUBLIC_URL=
