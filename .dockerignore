# Keeps the PHP site's Docker image to just what belongs on the public
# web root. Without this, `COPY . /var/www/html/` in the Dockerfile
# copies everything in the repo - including the standalone MCP server's
# source, package.json, and .env.example - straight into a
# publicly-downloadable path.

Wzone-ai/
# The api/v1 test runner drops every table in the database it is given.
tests/
.git/
.gitignore
.env
.env.*
*.md
Dockerfile
.dockerignore
node_modules/
